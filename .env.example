# Copy this file to .env.local for local development. Never commit real values.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_key_if_needed

# Application and token encryption
POSTFLOW_APP_URL=http://127.0.0.1:8080
POSTFLOW_TOKEN_ENCRYPTION_KEY=your_32_byte_base64_encryption_key
SOCIAL_TOKEN_ENC_KEY=your_32_byte_base64_encryption_key

# AI writing (server-only)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6-terra
# Optional fallback when OPENAI_API_KEY is not configured
LOVABLE_API_KEY=your_lovable_api_key

# YouTube
YOUTUBE_OAUTH_CLIENT_ID=your_youtube_client_id
YOUTUBE_OAUTH_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8080/api/public/oauth/callback/youtube

# Meta / Facebook / Instagram
META_OAUTH_CLIENT_ID=your_meta_app_id
META_OAUTH_CLIENT_SECRET=your_meta_app_secret
META_PAGES_MANAGE_POSTS_AVAILABLE=false
INSTAGRAM_OAUTH_CLIENT_ID=your_instagram_app_id
INSTAGRAM_OAUTH_CLIENT_SECRET=your_instagram_app_secret
# Instagram requires the exact HTTPS callback registered in the Meta app.
INSTAGRAM_REDIRECT_URI=https://your-app.example.com/api/public/oauth/callback/instagram
FACEBOOK_REDIRECT_URI=https://your-app.example.com/api/public/oauth/callback/facebook

# Pinterest
PINTEREST_OAUTH_CLIENT_ID=your_pinterest_client_id
PINTEREST_OAUTH_CLIENT_SECRET=your_pinterest_client_secret
PINTEREST_REDIRECT_URI=https://your-app.example.com/api/public/oauth/callback/pinterest

# Snapchat
SNAPCHAT_OAUTH_CLIENT_ID=your_snapchat_client_id
SNAPCHAT_OAUTH_CLIENT_SECRET=your_snapchat_client_secret
SNAPCHAT_OAUTH_PUBLIC_CLIENT_ID=your_snapchat_public_client_id
SNAPCHAT_REDIRECT_URI=http://127.0.0.1:8080/api/public/oauth/callback/snapchat
SNAPCHAT_PUBLIC_PROFILE_CLIENT_ID=your_snapchat_public_profile_client_id
SNAPCHAT_PUBLIC_PROFILE_CLIENT_SECRET=your_snapchat_public_profile_client_secret
SNAPCHAT_PUBLIC_PROFILE_REDIRECT_URI=http://127.0.0.1:8080/api/public/oauth/snapchat-public-profile/callback
SNAPCHAT_PP_API_BASE=https://businessapi.snapchat.com

# Optional media processor
MEDIA_PROCESSOR_URL=https://your-media-processor.example.com
MEDIA_PROCESSOR_TOKEN=your_media_processor_token
