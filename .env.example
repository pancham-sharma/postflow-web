# Public/client configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Server configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only privileged key. Configure one, never both in browser variables.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Public application origin used for OAuth callbacks.
POSTFLOW_APP_URL=http://127.0.0.1:8080

# Server-only YouTube channel connection credentials.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8080/api/public/oauth/callback/youtube

# AI features
LOVABLE_API_KEY=

# Social provider connections (server-only)
INSTAGRAM_OAUTH_CLIENT_ID=
INSTAGRAM_OAUTH_CLIENT_SECRET=
META_OAUTH_CLIENT_ID=
META_OAUTH_CLIENT_SECRET=
META_PAGES_MANAGE_POSTS_AVAILABLE=false
PINTEREST_OAUTH_CLIENT_ID=
PINTEREST_OAUTH_CLIENT_SECRET=
SNAPCHAT_OAUTH_CLIENT_ID=
SNAPCHAT_OAUTH_CLIENT_SECRET=
SNAPCHAT_OAUTH_PUBLIC_CLIENT_ID=
SNAPCHAT_REDIRECT_URI=
SNAPCHAT_PUBLIC_PROFILE_CLIENT_ID=
SNAPCHAT_PUBLIC_PROFILE_CLIENT_SECRET=
SNAPCHAT_PUBLIC_PROFILE_REDIRECT_URI=

# Encrypt stored social-provider tokens. Configure one name only.
POSTFLOW_TOKEN_ENCRYPTION_KEY=
# SOCIAL_TOKEN_ENC_KEY=

# Optional external media-processing worker
MEDIA_PROCESSOR_URL=
MEDIA_PROCESSOR_TOKEN=
